[Unit]
Description=StreamForge Encoding Panel
After=network-online.target streamforge-channel-supervisor.service
Wants=network-online.target streamforge-channel-supervisor.service

[Service]
Type=simple
User=streamforge
Group=streamforge
WorkingDirectory=/opt/streamforge
EnvironmentFile=/etc/streamforge.env
Environment=TMPDIR=/var/lib/streamforge/gunicorn-tmp
ExecReload=/bin/kill -HUP $MAINPID
ExecStart=/usr/bin/gunicorn app.main:app --bind 127.0.0.1:8800 --workers 1 --worker-class uvicorn_worker.UvicornWorker --worker-tmp-dir /var/lib/streamforge/gunicorn-tmp --timeout 120 --graceful-timeout 30 --keep-alive 5 --backlog 65535 --error-logfile -
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
LimitNOFILE=1048576
TasksMax=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/streamforge

[Install]
WantedBy=multi-user.target
