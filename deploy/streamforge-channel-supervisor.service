[Unit]
Description=StreamForge Main Channel Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streamforge
Group=streamforge
WorkingDirectory=/opt/streamforge
EnvironmentFile=/etc/streamforge.env
Environment=STREAMFORGE_MAIN_CHANNEL_SUPERVISOR_MODE=1
Environment=STREAMFORGE_MAIN_CHANNEL_SUPERVISOR_SOCKET=/var/lib/streamforge/main-channel-supervisor.sock
ExecStart=/usr/bin/python3 -m app.main_channel_supervisor
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=30
LimitNOFILE=1048576
TasksMax=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/streamforge

[Install]
WantedBy=multi-user.target
